# Generates signed-request vectors with the same mixlib-authentication version the
# app bundles, so the Rust verifier is checked against the protocol's origin.
#
#   harness/bin/signed_vectors > harness/fixtures/signed_requests.json
require "mixlib/authentication/signatureverification"
require "json"
require "openssl"
require "base64"
require "stringio"

KEY = OpenSSL::PKey::RSA.new(2048)
OTHER_KEY = OpenSSL::PKey::RSA.new(2048)
PUBLIC_PEM = KEY.public_key.to_pem
TIMESTAMP = Time.now.utc.iso8601
BODY = "the request body"

class FakeRequest
  attr_reader :method, :path, :env, :params, :raw_post

  def initialize(method:, path:, body:, params: {}, headers: {})
    @method = method
    @path = path
    @raw_post = body
    @params = params
    @env = { "HTTP_HOST" => "localhost:3005", "HTTP_X_OPS_USERID" => "ada" }
    headers.each { |name, value| @env["HTTP_#{name.tr('-', '_').upcase}"] = value }
  end
end

def sign(method:, path:, body:, version:, algorithm:, key: KEY, file: nil, timestamp: TIMESTAMP)
  object = Mixlib::Authentication::SignedHeaderAuth.signing_object(
    http_method: method, path: path, body: body, timestamp: timestamp, user_id: "ada", file: file
  )
  object.sign(key, algorithm, version)
end

def request(headers:, body: BODY, params: {}, path: "/api/v1/cookbooks", method: :post)
  FakeRequest.new(method: method, path: path, body: body, params: params, headers: headers)
end

def verify(headers, body: BODY, params: {}, path: "/api/v1/cookbooks", method: :post, key: KEY, skew: 15 * 60)
  verifier = Mixlib::Authentication::SignatureVerification.new
  result = verifier.authenticate_user_request(
    request(headers: headers, body: body, params: params, path: path, method: method),
    key.public_key,
    skew
  )
  result ? "ok" : "invalid"
rescue StandardError => e
  "#{e.class}: #{e.message}"
end

def vector(name, expect, headers:, **kwargs)
  {
    "name" => name,
    "expect" => expect,
    "public_key" => PUBLIC_PEM,
    "method" => "POST",
    "path" => "/api/v1/cookbooks",
    "body" => BODY,
    "params" => {},
    "headers" => headers.merge("Host" => "localhost:3005", "X-Ops-Userid" => "ada"),
    "now" => TIMESTAMP,
  }.merge(kwargs.transform_keys(&:to_s))
end

cases = []

%w[1.0 1.1 1.3].each do |version|
  algorithm = version == "1.3" ? "sha256" : "sha1"
  headers = sign(method: :post, path: "/api/v1/cookbooks", body: BODY, version: version, algorithm: algorithm)
  cases << vector("valid #{version}", "ok", headers: headers)
end

valid = sign(method: :post, path: "/api/v1/cookbooks", body: BODY, version: "1.0", algorithm: "sha1")

cases << vector(
  "wrong signature", "false",
  headers: valid.reject { |k, _| k.start_with?("X-Ops-Authorization") }
                 .merge("X-Ops-Authorization-1" => Base64.strict_encode64("garbage"))
)
cases << vector(
  "stale timestamp", "false",
  headers: sign(method: :post, path: "/api/v1/cookbooks", body: BODY, version: "1.0",
                algorithm: "sha1", timestamp: (Time.now.utc - 4000).iso8601)
)
cases << vector("wrong body", "false", headers: valid, body: "a different body")
cases << vector(
  "wrong key", "false",
  headers: sign(method: :post, path: "/api/v1/cookbooks", body: BODY, version: "1.3",
                algorithm: "sha256", key: OTHER_KEY)
)
cases << vector("missing timestamp", "false", headers: valid.reject { |k, _| k == "X-Ops-Timestamp" })
cases << vector("missing content hash", "false", headers: valid.reject { |k, _| k == "X-Ops-Content-Hash" })
cases << vector("missing sign", "false", headers: valid.reject { |k, _| k == "X-Ops-Sign" })
cases << vector(
  "unsupported version", "false",
  headers: valid.merge("X-Ops-Sign" => "algorithm=sha1;version=9.9;")
)
cases << vector(
  "version 1.1 hashes the user id", "ok",
  headers: sign(method: :post, path: "/api/v1/cookbooks", body: BODY, version: "1.1", algorithm: "sha1")
)
cases << vector(
  "path with duplicate and trailing slashes verifies", "ok",
  headers: sign(method: :post, path: "//api//v1/cookbooks/", body: BODY, version: "1.0", algorithm: "sha1"),
  path: "//api//v1/cookbooks/"
)
cases << vector(
  "multipart hashes the file part, not the body", "ok",
  headers: (file_signature = sign(method: :post, path: "/api/v1/cookbooks", body: nil,
                                  version: "1.0", algorithm: "sha1", file: StringIO.new("tarball bytes"))),
  body: "unrelated multipart envelope",
  file: "tarball bytes",
  params: { "tarball" => StringIO.new("tarball bytes") }
)

# Record what upstream actually decides, so the Rust table is derived, not guessed.
cases.each do |entry|
  headers = entry["headers"]
  actual = verify(headers, body: entry["body"], params: entry["params"].transform_values { |v| v.rewind && v },
                  path: entry["path"], key: KEY)
  entry["actual"] = actual
  entry["params"] = entry["params"].keys
end

# The private key is only needed by the signer, not the verifier.
puts JSON.pretty_generate("cases" => cases.map { |c| c.reject { |k, _| k == "params" } })
