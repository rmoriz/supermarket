  -- Explicit ids do not advance the sequences; move them past the fixtures so a
  -- publish does not collide on a primary key.
  SELECT setval(pg_get_serial_sequence('users', 'id'), (SELECT max(id) FROM users));
  SELECT setval(pg_get_serial_sequence('accounts', 'id'), (SELECT max(id) FROM accounts));
  SELECT setval(pg_get_serial_sequence('categories', 'id'), (SELECT max(id) FROM categories));
  SELECT setval(pg_get_serial_sequence('cookbooks', 'id'), (SELECT max(id) FROM cookbooks));
  SELECT setval(pg_get_serial_sequence('cookbook_versions', 'id'), (SELECT max(id) FROM cookbook_versions));
  SELECT setval(pg_get_serial_sequence('supported_platforms', 'id'), (SELECT max(id) FROM supported_platforms));
  SELECT setval(pg_get_serial_sequence('tools', 'id'), (SELECT max(id) FROM tools));
  SELECT setval(pg_get_serial_sequence('groups', 'id'), (SELECT max(id) FROM groups));
  SELECT setval(pg_get_serial_sequence('group_members', 'id'), (SELECT max(id) FROM group_members));
  SELECT setval(pg_get_serial_sequence('group_resources', 'id'), (SELECT max(id) FROM group_resources));
  SELECT setval(pg_get_serial_sequence('quality_metrics', 'id'), (SELECT max(id) FROM quality_metrics));
  SELECT setval(pg_get_serial_sequence('system_emails', 'id'), (SELECT max(id) FROM system_emails));
  SELECT setval(pg_get_serial_sequence('email_preferences', 'id'), (SELECT max(id) FROM email_preferences));
  SELECT setval(pg_get_serial_sequence('ownership_transfer_requests', 'id'), (SELECT max(id) FROM ownership_transfer_requests));
SQL

url = ENV["DATABASE_URL"] || "postgres://supermarket:supermarket@localhost:55432/supermarket_test"

# Local psql is optional: fall back to the harness container.
out, status =
  if system("command -v psql > /dev/null 2>&1")
    Open3.capture2e("psql", url, "-q", "-v", "ON_ERROR_STOP=1", stdin_data: SQL)
  else
    Open3.capture2e(
      "docker", "exec", "-i", "harness-postgres-1",
      "psql", "-U", "supermarket", "-d", "supermarket_test",
      "-q", "-v", "ON_ERROR_STOP=1", stdin_data: SQL
    )
  end
puts out
exit(status.exitstatus) unless status.success?

# Cache hygiene, best effort. The Rust port keeps its cache in Redis DB 1 and is
# flushed whole. The oracle keeps its rollout feature flags in DB 0, so only the
# universe cache keys are removed there; flushing DB 0 would deactivate every
# feature for the life of the Rails process (the adapter is memoized).
REDIS = ENV["REDIS_URL_RUST"] || "redis://localhost:56379/1"

def redis(*args)
  Open3.capture2e("docker", "exec", "harness-redis-1", "redis-cli", *args)
end

redis("-n", "1", "flushdb")
# Both sides cache the universe under these keys; the port must flush both.
redis("-n", "0", "set", "http-universe", "cached")
redis("-n", "0", "set", "https-universe", "cached")
redis("-n", "0", "eval",
      "for _, k in ipairs(redis.call('keys', '*-universe')) do redis.call('del', k) end return 1",
      "0")
